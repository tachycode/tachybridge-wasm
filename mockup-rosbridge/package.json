{
  "name": "tachybridge-mockup-rosbridge",
  "version": "0.1.0",
  "description": "Embeddable deterministic rosbridge mock server for end-to-end tests and local dev — attaches to any http/https.Server.",
  "license": "MIT",
  "type": "module",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tachycode/tachybridge-wasm.git",
    "directory": "mockup-rosbridge"
  },
  "homepage": "https://github.com/tachycode/tachybridge-wasm/tree/main/mockup-rosbridge#readme",
  "keywords": [
    "rosbridge",
    "mock",
    "tachybridge",
    "testing",
    "websocket"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.1",
    "selfsigned": "^5.5.0",
    "typescript": "^5.9.2",
    "vitest": "^4.0.3"
  }
}
